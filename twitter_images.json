{
  "id": "twitter_images",
  "name": "X / Twitter Images Only",
  "version": "1.0.0",
  "author": "InstaGrabber sample plugin",
  "targets": ["post", "image", "carousel"],
  "urlPattern": "(?:https?://)?(?:www\\.|mobile\\.)?(?:x\\.com|twitter\\.com)/(?:[^/?#]+/)*status/(?<shortcode>[0-9]+)",
  "request": {
    "method": "GET",
    "urlTemplate": "https://api.fxtwitter.com/2/status/{shortcode}",
    "headers": {
      "Accept": "application/json",
      "User-Agent": "InstaGrabber/1.0 (public post media fetcher)"
    }
  },
  "extract": {
    "ownerPath": "status.author.screen_name",
    "captionPath": "status.text",
    "itemsPath": "status.media.photos",
    "itemType": "type",
    "itemUrl": "url",
    "itemWidthPath": "width",
    "itemHeightPath": "height"
  }
}
